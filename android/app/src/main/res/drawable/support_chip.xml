<?xml version="1.0" encoding="utf-8"?>
<!-- The toolbar chip. A full capsule with a hairline pale-blue outline and a barely-there fill,
     so it reads as a control rather than as a badge stuck on top of the bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/support_chip_fill" />
    <stroke android:width="1dp" android:color="@color/support_chip_stroke" />
    <corners android:radius="999dp" />
</shape>
