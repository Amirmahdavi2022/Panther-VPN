<?xml version="1.0" encoding="utf-8"?>
<!-- The toolbar chip. A hairline outline and a barely-there fill, so it reads as a control
     rather than as a badge stuck on top of the bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#141A24" />
    <stroke android:width="1dp" android:color="#24354A" />
    <corners android:radius="13dp" />
</shape>
