<?xml version="1.0" encoding="utf-8"?>
<!-- The armed Stealth card. Same shape as the blue one so the row stays consistent; only the
     colour differs, because it is a different kind of connection and should not be mistaken
     for the other two. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stealth_violet_soft" />
            <stroke android:width="1.5dp" android:color="@color/stealth_violet" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
