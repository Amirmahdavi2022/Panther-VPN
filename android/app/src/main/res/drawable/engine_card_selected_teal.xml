<?xml version="1.0" encoding="utf-8"?>
<!-- The armed Relay card. Same shape as the other three so the row stays consistent; only the
     colour differs, because the traffic leaves through a volunteer's machine rather than a route
     Panther runs, and that is worth reading as its own thing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#0C3B34" android:endColor="@color/relay_teal_soft" />
            <stroke android:width="1.5dp" android:color="@color/relay_teal" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
