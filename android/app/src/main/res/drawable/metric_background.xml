<?xml version="1.0" encoding="utf-8"?>
<!-- Same glass treatment as card_background, at the smaller radius the metric tiles use. The
     padding sits on the outer item so the tiles keep their spacing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1A1A20" android:endColor="#0E0E12" />
            <stroke android:width="1dp" android:color="@color/card_border" />
            <corners android:radius="16dp" />
            <padding android:left="8dp" android:top="12dp" android:right="8dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#12FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.2" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
