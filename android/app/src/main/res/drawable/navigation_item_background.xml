<?xml version="1.0" encoding="utf-8"?>
<!--
    The selected row. A faint accent wash with a hairline, rather than the flat white overlay it
    was, so the checked item is picked out by the same colour that means "on" everywhere else.

    The side inset lives in the drawable rather than in app:itemShapeInsetStart on the
    NavigationView. Read out of NavigationView 1.12.0 rather than assumed: those inset attributes
    are only consulted when itemBackground has NOT been set (it builds a shaped background from
    them instead), so setting both leaves the insets doing nothing and the pill running edge to
    edge. Putting the inset here works either way.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp">
            <shape android:shape="rectangle">
                <solid android:color="#142440" />
                <stroke android:width="1dp" android:color="#2A4A78" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp">
            <shape android:shape="rectangle">
                <solid android:color="#16161C" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
