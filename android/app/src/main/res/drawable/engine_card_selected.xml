<?xml version="1.0" encoding="utf-8"?>
<!-- The selected engine is the one place besides the connected orb that carries the accent
     colour, so which engine is armed is readable at a glance and never ambiguous. The fill
     glows from the top, where the icon and title sit. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1C3566" android:endColor="#0C1830" />
            <stroke android:width="1.5dp" android:color="@color/blue_600" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
